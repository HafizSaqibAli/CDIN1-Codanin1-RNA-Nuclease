source leaprc.RNA.OL3
source leaprc.DNA.OL21
source leaprc.protein.ff14SB
source leaprc.water.TIP3P

mol = loadpdb CDIN1_RNA-DNA.pdb

solvateOct mol TIP3PBOX 10.0
addions mol Na+ 0
addions mol Cl- 0
saveamberparm mol Mg2_CDIN1_sub_solv.prmtop Mg2_CDIN1_sub_solv.inpcrd
savepdb mol Mg2_CDIN1_sub_solv.pdb
quit
